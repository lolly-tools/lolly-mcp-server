# Copy to deploy.env (gitignored) and fill in. deploy.sh sources this.

# ── required ─────────────────────────────────────────────────────────────────
PROJECT_ID=your-gcp-project-id

# The bearer token / OAuth consent passphrase (same value as the Vercel endpoint
# so one credential works for both). It's in plans/secrets.md.
LOLLY_MCP_TOKEN=paste-the-lolly-mcp-token

# HMAC key that signs OAuth access/refresh tokens. Reuse the value already in
# Vercel (plans/secrets.md), or mint a new one: openssl rand -base64 32
LOLLY_MCP_SIGNING_SECRET=paste-the-signing-secret

# ── optional (sensible defaults) ─────────────────────────────────────────────
# REGION=us-central1
# SERVICE=lolly-mcp
# AR_REPO=lolly
# LOLLY_WEB_BASE=https://lolly.tools   # web shell the container drives for Tier B
